# ---------- Phase 7: Semantic Analysis (API patterns) ---------------
echo "[Phase 7] Semantic analysis"
python3 -c "
import glob, re, json
from collections import defaultdict
patterns = defaultdict(list)
for f in glob.glob('$WORKDIR/js_files/*_beautified.js'):
    c = open(f).read()
    patterns['fetch'].extend(re.findall(r\"fetch\s*\(\s*['\"]([^'\"]+)['\"]\", c))
    patterns['http_method'].extend(re.findall(r\"(?:axios|http)\s*\.\s*(?:get|post|put|delete|patch)\s*\(\s*['\"]([^'\"]+)['\"]\", c))
    patterns['xhr'].extend([f'{m} {e}' for m,e in re.findall(r\"open\s*\(\s*['\"]([A-Z]+)['\"],\s*['\"]([^'\"]+)['\"]\", c)])
json.dump({k: list(set(v)) for k,v in patterns.items()}, open('$WORKDIR/results/api_patterns.json','w'), indent=2)
print('[*] API patterns saved')
"

# --- Manual hints (no nuclei) -----------------------------------------
echo ""
echo "[*] Pipeline completed at $(date)"
echo "    All output in: $WORKDIR/"
echo "    Manual steps:"
echo "      - mitmproxy2swagger while browsing"
echo "      - Gitleaks on repo if accessible"
echo "      - Review screenshots: $WORKDIR/screenshots/"
